# =============================================================================
# .env.example — variáveis de ambiente (apenas segredos/endpoints). Copie para `.env`.
# NUNCA commite o arquivo `.env` real. Chaves de API não vão em configs/.
# Prefixo/aninhamento: use `__` (ex.: MODEL__ACTIVE_MODEL=lightgbm).
# =============================================================================

# Token do Codecov (upload de cobertura no CI) — opcional localmente.
# CODECOV_TOKEN=

# Semente global (sobrescreve config.yaml se definida).
# RANDOM_SEED=42

# Backend do MLflow: SEMPRE banco (SQLite local por padrão), nunca o file store ./mlruns.
# Sobrescreve experiment.tracking_uri de configs/config.yaml (ex.: servidor do docker compose).
# MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Este projeto usa dados públicos e não requer credenciais externas.
